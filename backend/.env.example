# Puerto de la API
PORT=3000
# Cadena de conexión de Neon (Dashboard > Connect)
DATABASE_URL=postgresql://usuario:contraseña@ep-ejemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Origen permitido del cliente React (Vite)
CLIENT_URL=http://localhost:5173

# Login (INV01)
# Secreto para firmar los JWT: una cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Cuentas que crea `node db/seed-users.js` (contraseñas de 12 caracteres o más)
ADMIN_EMAIL=admin@catalogo.test
ADMIN_PASSWORD=escribe-una-contraseña-segura
USER_EMAIL=consulta@catalogo.test
USER_PASSWORD=escribe-otra-contraseña-segura
# Opcional: intentos de login permitidos cada 15 minutos por IP (por defecto 10)
# LOGIN_MAX_ATTEMPTS=10
